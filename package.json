{
  "name": "rbs-inline-syntax",
  "displayName": "rbs-inline Syntax",
  "version": "0.1.2",
  "description": "Highlights rbs-inline `# @rbs` and `# @dynamic` annotations in Ruby comments.",
  "categories": [
    "Programming Languages"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bottrall/rbs-inline-syntax.git"
  },
  "publisher": "bottrall",
  "type": "module",
  "devDependencies": {
    "@bottrall/oxlint-config": "^0.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "vitest": "^5.1.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "contributes": {
    "grammars": [
      {
        "path": "./syntaxes/rbs-inline.injection.json",
        "scopeName": "rbs-inline.injection",
        "injectTo": [
          "source.ruby"
        ]
      }
    ]
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "packageManager": "pnpm@12.18.0"
}
