{
  "name": "rbs-inline-syntax",
  "displayName": "rbs-inline Syntax",
  "description": "Highlights rbs-inline `# @rbs` and `# @dynamic` annotations in Ruby comments.",
  "version": "0.1.1",
  "publisher": "bottrall",
  "license": "MIT",
  "type": "module",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "grammars": [
      {
        "path": "./syntaxes/rbs-inline.injection.json",
        "scopeName": "rbs-inline.injection",
        "injectTo": [
          "source.ruby"
        ]
      }
    ]
  },
  "scripts": {
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --check test",
    "format:fix": "oxfmt --write test",
    "test": "node --test 'test/**/*.test.js'"
  },
  "devDependencies": {
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bottrall/rbs-inline-syntax.git"
  },
  "packageManager": "pnpm@12.18.0"
}
